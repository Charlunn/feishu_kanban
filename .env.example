# =============================================
# 数据库连接
# =============================================
# Docker Compose 部署时自动通过 docker-entrypoint.sh 注入，无需手动设置
# 本地开发（不用 Docker）时填写：
# DATABASE_URL=postgresql://kanban:your_password@localhost:5432/kanban
# 如果不设置，应用使用内存存储（重启丢数据，仅用于开发）
DATABASE_URL=
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 事件回调验证 Token（飞书开放平台 → 事件与回调 → Verification Token）
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx

# 消息加密 Key（生产环境建议开启，飞书开放平台 → 事件与回调 → Encrypt Key）
FEISHU_ENCRYPT_KEY=

# 机器人发消息的默认群 chat_id
FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxx

# =============================================
# 多维表格 Bitable 镜像（可选）
# =============================================
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# =============================================
# 前端公开变量
# =============================================
NEXT_PUBLIC_APP_BASE_URL=https://kanban.yourcompany.com
NEXT_PUBLIC_FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx

# =============================================
# 飞书开放平台需要申请的权限
# =============================================
# im:message:send_as_bot          机器人发消息/卡片
# im:message.patch                更新已发送的卡片 (in-place)
# im:message.pin                  置顶消息
# im:message.reaction:write       给消息加 reaction (✅)
# im:message.reaction.created_v1  订阅 reaction 事件
# im.message.receive_v1           订阅 @ 消息事件
# contact:user.base:readonly      免登读取用户信息
# calendar:calendar               创建日历事件(会议)
# presence:user_presence:readonly 查询用户在线状态
# task:task                       创建飞书原生任务
# bitable:record:write            写入多维表格

# =============================================
# 功能说明
# =============================================
# 到期提醒：POST /api/feishu/reminders（建议 cron 每小时一次）
# 每日摘要：POST /api/feishu/push-digest（建议 cron 每天早 9 点）
# Bitable 全量同步：POST /api/feishu/bitable-sync（初次部署后手动触发一次）
